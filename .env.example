# ============================================================
# NyayAlay / Adhisthan — Environment Template (FAANG Standard)
# ============================================================
# Copy this file to .env and fill real values.
# NEVER commit the real .env file.

# --------------------
# Application
# --------------------
NODE_ENV=development
APP_NAME=nyayalay
APP_PORT=3000
API_PREFIX=/api/v1

# --------------------
# Database (PostgreSQL + pgvector)
# --------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nyayalay
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=nyayalay
DATABASE_URL=postgresql://nyayalay:change_me_strong_password@postgres:5432/nyayalay?schema=public

# --------------------
# Auth / JWT
# --------------------
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --------------------
# Internal Service Auth (NestJS ↔ FastAPI)
# --------------------
INTERNAL_SERVICE_KEY=change_me_internal_service_key_min_32_chars

# --------------------
# AI Service
# --------------------
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_PORT=8000

# --------------------
# Rate Limiting
# --------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --------------------
# Logging
# --------------------
LOG_LEVEL=debug


# --------------------
# LLM Provider
# --------------------
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini